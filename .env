# =====================================================================
# AI Company MVP Environment Variables
# =====================================================================

# Database Settings
DATABASE_URL=sqlite+aiosqlite:///./aicompany.db
SYNC_DATABASE_URL=sqlite:///./aicompany.db
# For PostgreSQL in Docker / Production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aicompany
# SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aicompany

# LLM Providers (Leave empty or 'mock' to use high-fidelity local simulator)
OPENAI_API_KEY=mock-key
ANTHROPIC_API_KEY=mock-key
LLM_PROVIDER=mock  # options: mock, openai, anthropic

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=super-secret-jwt-signing-key-for-mvp-company
ACCESS_TOKEN_EXPIRE_MINUTES=1440
WORKSPACE_ROOT=./workspace_repos
